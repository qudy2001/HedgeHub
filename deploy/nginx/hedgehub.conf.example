server {
  listen 8787 ssl http2;
  listen [::]:8787 ssl http2;
  server_name hedgehub.nas.home;

  ssl_certificate /etc/nginx/certs/local-whildcard.crt;
  ssl_certificate_key /etc/nginx/certs/local-whildcard.key;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_protocols TLSv1.2 TLSv1.3;

  access_log /var/log/nginx/hedgehub.access.log;
  error_log /var/log/nginx/hedgehub.error.log warn;

  location / {
    proxy_pass http://hedgehub:8787;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
  }
}

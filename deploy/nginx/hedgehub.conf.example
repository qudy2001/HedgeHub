server {
  listen 80;
  listen [::]:80;
  server_name hedgehub.example.com;

  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name hedgehub.example.com;

  ssl_certificate /etc/letsencrypt/live/hedgehub.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/hedgehub.example.com/privkey.pem;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_protocols TLSv1.2 TLSv1.3;

  access_log /var/log/nginx/hedgehub.access.log;
  error_log /var/log/nginx/hedgehub.error.log warn;

  location / {
    proxy_pass http://192.168.1.50:8787;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
  }
}

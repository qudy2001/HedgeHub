{
  "openapi": "3.1.0",
  "info": {
    "title": "HedgeHub Programmatic API",
    "version": "1.1.0",
    "description": "Programmatic HedgeHub endpoints for GPT strategy queries and daily market-data snapshots. Authentication uses the x-api-key header."
  },
  "servers": [
    {
      "url": "http://YOUR_HOST:8788"
    }
  ],
  "paths": {
    "/api/gpt/strategy-query": {
      "post": {
        "operationId": "queryStrategies",
        "summary": "Query strategy scanners for a ticker",
        "description": "Returns grouped results from Threshold Hedge, TradingView Scanner, and Covered Income.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StrategyQueryRequest"
              },
              "example": {
                "ticker": "AAPL",
                "optionExpirationStartDate": "2026-06-01",
                "optionExpirationEndDate": "2026-07-31",
                "expectedPriceRangeLow": 185,
                "expectedPriceRangeHigh": 215,
                "topX": 5
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/market-data": {
      "get": {
        "operationId": "getMarketDataSnapshot",
        "summary": "Get a daily technical analysis snapshot for a ticker",
        "description": "Returns a daily OHLCV snapshot with RSI, MACD, Bollinger Bands, ATR, and 50-day/200-day moving averages for the requested ticker. Authentication uses the x-api-key header.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "description": "Ticker symbol, for example AAPL or NVDA.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "description": "Candle interval. Only daily candles are currently supported.",
            "schema": {
              "type": "string",
              "enum": [
                "1d"
              ],
              "default": "1d"
            }
          },
          {
            "name": "look_back_days",
            "in": "query",
            "required": false,
            "description": "Number of calendar days to include in the daily technical snapshot.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650,
              "default": 180
            }
          },
          {
            "name": "curr_date",
            "in": "query",
            "required": false,
            "description": "Snapshot end date in YYYY-MM-DD format. Defaults to the server's current date.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataSnapshotResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No market data found for the requested symbol/date window",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream market data provider error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }

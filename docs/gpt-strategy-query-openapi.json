          "ticker",
          "optionExpirationStartDate",
          "optionExpirationEndDate",
          "expectedPriceRangeLow",
          "expectedPriceRangeHigh"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Underlying ticker symbol.",
            "examples": [
              "AAPL",
              "SPY",
              "TSLA"
            ]
          },
          "optionExpirationStartDate": {
            "type": "string",
            "format": "date",
            "description": "Start of option expiration window in YYYY-MM-DD."
          },
          "optionExpirationEndDate": {
            "type": "string",
            "format": "date",
            "description": "End of option expiration window in YYYY-MM-DD."
          },
          "expectedPriceRangeLow": {
            "type": "number",
            "description": "Expected underlying price low."
          },
          "expectedPriceRangeHigh": {
            "type": "number",
            "description": "Expected underlying price high."
          },
          "topX": {
            "type": "integer",
            "minimum": 1,
            "description": "Optional per-scanner result cap. For example, topX=5 returns up to 5 ranked results from each scanner."
          }
        }
      },

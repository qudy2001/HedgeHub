# Database
DB_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=optionsdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optionsdb
SQLITE_DATA_DIR=./data
SQLITE_DB_PATH=./data/hedgehub.db

# Optional: enables live Polygon option-chain data.
# Leave blank to fall back to modeled option data.
POLYGON_API_KEY=

# Database
DB_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=optionsdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optionsdb
SQLITE_DATA_DIR=./data
SQLITE_DB_PATH=./data/hedgehub.db

# Tiger market-data bridge (optional). Leave MARKET_DATA_PROVIDER blank to
# keep using Yahoo/Polymarket. Run tiger-bridge/app.py locally and point
# TIGER_BRIDGE_URL at it, or use the Docker tiger-bridge service.
MARKET_DATA_PROVIDER=
TIGER_BRIDGE_URL=http://localhost:8788
TIGER_BRIDGE_TOKEN=

# TradingAgents AI research integration (optional). See TradingAgents/
# sibling repo for the web service; generate TRADINGAGENTS_TOKEN from its
# web UI once it's running.
TRADINGAGENTS_URL=
TRADINGAGENTS_TOKEN=

# Docker Compose host settings
HEDGEHUB_CONTAINER_NAME=hedgehub
HEDGEHUB_IMAGE=ghcr.io/qudy2001/hedgehub-livedata:latest
HEDGEHUB_IBKR_IMAGE=ghcr.io/qudy2001/hedgehub-livedata-ibkr:latest
HEDGEHUB_PORT=8787
HEDGEHUB_TZ=Europe/London
POLYGON_API_KEY=
# Optional websocket override if Massive / Polygon publishes a new endpoint.
POLYGON_WS_URL=
IBKR_CP_BASE_URL=https://ibkr-gateway:5000/v1/api
IBKR_CP_ACCOUNT_ID=
IBKR_CP_ALLOW_SELF_SIGNED=true
IBKR_CP_REQUIRE_PAPER=true
IBKR_SYNC_INTERVAL_MS=15000

# Optional IBKR Client Portal Gateway sidecar.
# Put the unzipped IBKR bundle in ./vendor/clientportal.gw, then enable the profile with:
# docker compose --profile ibkr up -d
IBKR_GATEWAY_CONTAINER_NAME=ibkr-gateway
IBKR_GATEWAY_IMAGE=ghcr.io/qudy2001/hedgehub-ibkr-gateway:latest
IBKR_GATEWAY_HOST_PORT=5001
IBKR_GATEWAY_PORT=5000
IBKR_GATEWAY_TZ=Europe/London
IBKR_GATEWAY_DIR=./vendor/clientportal.gw
HEDGEHUB_PUBLIC_DIR=./public

# Optional single-container image that runs HedgeHub and IBKR Gateway together.
# Use deploy/docker-compose.ibkr-embedded.example.yml when you want HedgeHub to
# reach the gateway over 127.0.0.1 inside the same container.

# Replace these with absolute NAS paths if preferred, for example:
# /volume1/docker/hedgehub/data
# /volume1/docker/hedgehub/dashboards
HEDGEHUB_DATA_DIR=./data
HEDGEHUB_DASHBOARDS_DIR=./dashboards

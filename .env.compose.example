# Docker Compose host settings
HEDGEHUB_WEB_CONTAINER_NAME=hedgehub-web
HEDGEHUB_SCANNER_CONTAINER_NAME=hedgehub-scanner
HEDGEHUB_IMAGE=ghcr.io/qudy2001/hedgehub-postgresql:latest
HEDGEHUB_PORT=8787
HEDGEHUB_TZ=Europe/London

# Database
DB_TYPE=postgres
POSTGRES_CONTAINER_NAME=hedgehub-postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=optionsdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/optionsdb
SQLITE_DB_PATH=/app/data/hedgehub.db

# Runtime role split (see README "Database modes")
HEDGEHUB_ROLE=web
HEDGEHUB_ENABLE_HTTP=true
HEDGEHUB_ENABLE_BACKGROUND_JOBS=false

# Tiger market-data bridge (see tiger-bridge/). Optional — the tiger-bridge
# container only starts with `docker compose --profile tiger up -d`.
# Leave MARKET_DATA_PROVIDER blank to keep using Yahoo/Polymarket instead.
MARKET_DATA_PROVIDER=
TIGER_BRIDGE_CONTAINER_NAME=tiger-bridge
TIGER_BRIDGE_URL=http://tiger-bridge:8788
TIGER_BRIDGE_TOKEN=
# Host path to your Tiger SDK .properties file (not a folder).
TIGER_CONFIG_FILE=
TIGER_CLAIM_DEVICE=false

# TradingAgents AI research integration (see TradingAgents/ sibling repo).
# Optional — the tradingagents container only starts with
# `docker compose --profile tradingagents up -d`. After it's running, open
# http://localhost:8000, log in with TRADINGAGENTS_WEB_ADMIN_PASSWORD, and
# issue an API token from its UI — use that generated token (not the admin
# password) as TRADINGAGENTS_TOKEN below.
TRADINGAGENTS_CONTAINER_NAME=tradingagents-web
TRADINGAGENTS_PORT=8000
TRADINGAGENTS_WEB_ADMIN_PASSWORD=
TRADINGAGENTS_URL=http://tradingagents:8000
TRADINGAGENTS_TOKEN=

HEDGEHUB_PUBLIC_DIR=./public

# Replace these with absolute NAS paths if preferred, for example:
# /volume1/docker/hedgehub/data
# /volume1/docker/hedgehub/dashboards
HEDGEHUB_DATA_DIR=./data
HEDGEHUB_DASHBOARDS_DIR=./dashboards

    {
      "name": "05 · Option expirations / 自动选择到期日",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{tigerBridgeUrl}}/options/expirations?symbol={{symbol}}",
          "host": [
            "{{tigerBridgeUrl}}"
          ],
          "path": [
            "options",
            "expirations"
          ],
          "query": [
            {
              "key": "symbol",
              "value": "{{symbol}}"
            }
          ]
        },
        "description": "Automatically selects the first future expiry and clears the previous contract. Run again after changing symbol. You may then edit expiry manually before request 06."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Timestamped bridge response', () => { pm.expect(body).to.have.property('data'); pm.expect(Number.isFinite(Date.parse(body.fetchedAt))).to.eql(true); });",
              "pm.environment.unset('expiry'); pm.environment.unset('contractSymbol');",
              "const today = new Date().toISOString().slice(0, 10);",
              "const expiries = (Array.isArray(body.data) ? body.data : []).map(x => x.date).filter(x => typeof x === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(x) && x > today).sort();",
              "pm.test('Future expiry available', () => pm.expect(expiries.length).to.be.above(0));",
              "if (expiries.length) pm.environment.set('expiry', expiries[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 · Option chain / 自动选择期权合约",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{tigerBridgeUrl}}/options/chain?symbol={{symbol}}&expiry={{expiry}}",
          "host": [
            "{{tigerBridgeUrl}}"
          ],
          "path": [
            "options",
            "chain"
          ],
          "query": [
            {
              "key": "symbol",
              "value": "{{symbol}}"
            },
            {
              "key": "expiry",
              "value": "{{expiry}}"
            }
          ]
        },
        "description": "Selects a positive, uncrossed bid/ask contract of optionType, prioritising volume. This is only a test sample, not a trade recommendation. Inspect IV, volume and open interest separately."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Timestamped bridge response', () => { pm.expect(body).to.have.property('data'); pm.expect(Number.isFinite(Date.parse(body.fetchedAt))).to.eql(true); });",
              "pm.environment.unset('contractSymbol');",
              "const side = String(pm.environment.get('optionType') || 'put').toLowerCase();",
              "const rows = (Array.isArray(body.data) ? body.data : []).filter(x => String(x.put_call).toLowerCase() === side && x.identifier && Number(x.bid_price) > 0 && Number(x.ask_price) >= Number(x.bid_price)).sort((a,b) => Number(b.volume || 0)-Number(a.volume || 0));",
              "pm.test('Contract with valid bid/ask found', () => pm.expect(rows.length).to.be.above(0));",
              "if (rows.length) pm.environment.set('contractSymbol', rows[0].identifier);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 · Option bid/ask timestamps / 期权盘口时效",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{tigerBridgeUrl}}/options/depth?symbol={{symbol}}&contract={{contractSymbol}}",
          "host": [
            "{{tigerBridgeUrl}}"
          ],
          "path": [
            "options",
            "depth"
          ],
          "query": [
            {
              "key": "symbol",
              "value": "{{symbol}}"
            },
            {
              "key": "contract",
              "value": "{{contractSymbol}}"
            }
          ]
        },
        "description": "The bridge uses get_option_depth for quote timestamps. Turn requireFreshQuotes=true during active US trading. Old quotes after close do not by themselves indicate missing permission."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Timestamped bridge response', () => { pm.expect(body).to.have.property('data'); pm.expect(Number.isFinite(Date.parse(body.fetchedAt))).to.eql(true); });",
              "const id = pm.environment.get('contractSymbol');",
              "const depth = body.data && (body.data[id] || (body.data.identifier === id ? body.data : null));",
              "const bids = (depth?.bids || []).filter(x => Number(x[0]) > 0 && Number(x[1]) > 0).sort((a,b)=>Number(b[0])-Number(a[0]));",
              "const asks = (depth?.asks || []).filter(x => Number(x[0]) > 0 && Number(x[1]) > 0).sort((a,b)=>Number(a[0])-Number(b[0]));",
              "pm.test('Positive uncrossed option market', () => { pm.expect(bids.length).to.be.above(0); pm.expect(asks.length).to.be.above(0); pm.expect(Number(asks[0][0])).to.be.at.least(Number(bids[0][0])); });",
              "function ms(v) { const n=Number(v); if(!Number.isFinite(n)||n<=0)return NaN; return n>1e17?n/1e6:n>1e14?n/1e3:n<1e11?n*1e3:n; }",
              "const stamp = Math.min(ms(bids[0]?.[2]), ms(asks[0]?.[2]));",
              "pm.test('Bid/ask timestamp provided', () => pm.expect(Number.isFinite(stamp)).to.eql(true));",
              "if (pm.environment.get('requireFreshQuotes') === 'true') pm.test('Both sides updated within 90 seconds', () => { const age=Date.now()-stamp; pm.expect(age).to.be.within(-5000,90000); });"
            ]
          }
        }
      ]
    },

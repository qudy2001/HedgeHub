      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Timestamped bridge response', () => { pm.expect(body).to.have.property('data'); pm.expect(Number.isFinite(Date.parse(body.fetchedAt))).to.eql(true); });",
              "pm.test('Positive underlying price returned', () => { pm.expect(body.data).to.be.an('array').that.is.not.empty; pm.expect(Number(body.data[0].latest_price)).to.be.above(0); });"
            ]

{
  "info": {
    "name": "HedgeHub · Tiger Read-Only Subscription Check",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Tests the implemented local Python SDK bridge, not Tiger native HTTP APIs. Start tiger-bridge/app.py first. No orders, subscription purchases or credential changes. See Tiger-Subscription-Check.zh-CN.md."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tigerBridgeToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 · Bridge health / 本地连接",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{tigerBridgeUrl}}/health",
          "host": [
            "{{tigerBridgeUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Only checks local bridge configuration; does not validate Tiger credentials or subscriptions."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Timestamped bridge response', () => { pm.expect(body).to.have.property('data'); pm.expect(Number.isFinite(Date.parse(body.fetchedAt))).to.eql(true); });",
              "pm.test('Read-only bridge configured', () => { pm.expect(body.data.readOnly).to.eql(true); pm.expect(body.data.configured).to.eql(true); });"
            ]
          }
        }
      ]
    },
